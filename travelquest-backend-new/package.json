{
  "name": "travelquest-backend",
  "version": "1.0.0",
  "description": "TravelQuest Backend API using AWS SAM and TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:clean": "rm -rf dist && npm run build",
    "watch": "tsc -w",
    "dev": "concurrently \"npm run watch\" \"npm run sam:local\" \"npm run db:local\"",
    "db:local": "docker run -d -p 8000:8000 --name travelquest-dynamodb-local amazon/dynamodb-local:latest || echo 'DynamoDB already running'",
    "db:seed": "node scripts/seed-data.js",
    "db:reset": "npm run db:stop && npm run db:local && sleep 5 && npm run db:seed",
    "db:stop": "docker stop travelquest-dynamodb-local && docker rm travelquest-dynamodb-local || echo 'DynamoDB not running'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=text-lcov > coverage/lcov.info && jest --coverage --coverageReporters=json-summary --coverageReporters=html",
    "test:integration": "jest --testMatch='**/tests/integration.test.ts'",
    "test:e2e": "jest --testMatch='**/tests/e2e.test.ts'",
    "test:performance": "jest --testMatch='**/tests/performance.test.ts'",
    "test:load": "artillery run tests/load-test.yml",
    "test:report": "jest --coverage --coverageReporters=cobertura --testResultsProcessor=jest-sonar-reporter",
    "test:performance-report": "lhci autorun",
    "test:badges": "jest-coverage-badges",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "lint:check": "eslint . --ext .ts --max-warnings 0",
    "lint:report": "eslint . --ext .ts --format json --output-file eslint-report.json",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "type-check": "tsc --noEmit",
    "security:scan": "snyk test",
    "security:monitor": "snyk monitor",
    "sam:build": "sam build",
    "sam:local": "sam local start-api",
    "sam:deploy": "sam deploy --guided",
    "sam:deploy:dev": "sam deploy --config-env dev",
    "sam:deploy:staging": "sam deploy --config-env staging",
    "sam:deploy:prod": "sam deploy --config-env production",
    "sam:logs": "sam logs --stack-name travelquest-backend",
    "sam:validate": "sam validate",
    "docs": "node docs/swagger-server.js",
    "docs:dev": "nodemon docs/swagger-server.js",
    "docs:generate": "swagger-jsdoc -d docs/swagger-definition.js -o docs/api-spec.json src/handlers/*.ts",
    "docs:validate": "swagger-parser validate docs/api-spec.json",
    "clean": "rm -rf dist node_modules .aws-sam coverage test-results.xml eslint-report.json",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "pre-push": "npm run test && npm run lint:check",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.438.0",
    "@aws-sdk/lib-dynamodb": "^3.438.0",
    "aws-lambda": "^1.0.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@middy/core": "^6.4.1",
    "@middy/http-cors": "^6.4.1",
    "@middy/http-error-handler": "^6.4.1",
    "@middy/http-json-body-parser": "^6.4.1",
    "@types/aws-lambda": "^8.10.126",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.9.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^8.53.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2",
    "artillery": "^2.0.0",
    "audit-ci": "^6.6.1",
    "husky": "^8.0.3",
    "jest-coverage-badges": "^1.1.2",
    "jest-sonar-reporter": "^2.0.0",
    "@lhci/cli": "^0.12.0",
    "lint-staged": "^15.0.2",
    "prettier": "^3.0.3",
    "snyk": "^1.1244.0",
    "standard-version": "^9.5.0",
    "supertest": "^6.3.3",
    "concurrently": "^8.2.2",
    "express": "^4.18.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "nodemon": "^3.0.1",
    "swagger-parser": "^10.0.3"
  },
  "keywords": [
    "aws",
    "sam",
    "serverless",
    "typescript",
    "lambda",
    "api-gateway",
    "dynamodb",
    "travel",
    "tourism"
  ],
  "author": "TravelQuest Team",
  "license": "MIT",
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run test && npm run lint:check"
    }
  },
  "jest": {
    "coverageThreshold": {
      "global": {
        "branches": 75,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
